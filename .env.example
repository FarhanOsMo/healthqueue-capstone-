# Copy to .env (git-ignored) and change the password. No cloud credentials are
# needed anywhere in the default setup.
#
# Generate a random password:
#   PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
#   bash:        openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-a-random-value
LOG_LEVEL=INFO
API_PORT=8080

# Local (non-Docker) run uses SQLite by default:
# DATABASE_URL=sqlite:///./data/healthqueue.db
# Optional tracing export (off by default):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACE_CONSOLE=true
