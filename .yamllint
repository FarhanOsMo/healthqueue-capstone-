extends: default
ignore: |
  .venv/
  .local/
  reports/
  **/.terraform/
rules:
  line-length:
    max: 140
    allow-non-breakable-inline-mappings: true  # long URLs
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on"]
  comments:
    min-spaces-from-content: 1
  indentation:
    indent-sequences: consistent
