# Copy to backend.hcl and fill in the real account ID.
# The bucket is created once by infra/bootstrap (versioned, KMS-encrypted, private).
bucket       = "healthqueue-tfstate-123456789012"
key          = "healthqueue/production/platform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3 conditional-write lock object: <key>.tflock
kms_key_id   = "arn:aws:kms:us-east-1:123456789012:alias/healthqueue-tfstate" # from bootstrap output
